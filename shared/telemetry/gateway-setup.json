{
  "NodeHostName": "localhost",
  "BlockedRolePrefixes": [
    "documentdb",
    "citus",
    "pg",
    "internal_role"
  ],
  "PostgresPort": 9712,
  "GatewayListenPort": 10260,
  "HostConfigurationWatchIntervalMs": 1000,
  "CertificateOptions": {
    "CertType": "PemAutoGenerated"
  },
  "UseLocalHost": false,
  "TelemetryOptions": {
    "ServiceName": "documentdb_gateway",
    "Tracing": {
      "Enabled": true,
      "OtlpEndpoint": "http://otel-collector:4317",
      "ExportTimeoutMs": 10000
    }
  }
}
